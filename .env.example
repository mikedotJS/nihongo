# Copy to .env.local and fill in. .env.local is gitignored.
#
# `based` BaaS — synchro asynchrone, opportuniste (cf. brief §2).
# Si VITE_BASED_URL est absent, l'app fonctionne en local-only sans tenter
# aucune connexion (PWA hors-ligne nominale).

VITE_BASED_URL=https://nihongo.based.weirdscience.dev
VITE_BASED_ANON_KEY=xdk-OuMJEV8-7pk5mW-JrfLK2O2423H6loj9Fw2B2yM

# Session pré-authentifiée (mono-utilisateur, multi-device, pas d'écran auth en v1).
# Format : JSON `{ "user": { "id": "...", "email": "..." }, "accessToken": "...", "refreshToken": "..." }`
# Obtention :
#   curl -s -X POST "$VITE_BASED_URL/auth/signin" \
#     -H 'content-type: application/json' \
#     -H "apikey: $VITE_BASED_ANON_KEY" \
#     -d '{"email":"...","password":"..."}'
# Coller le JSON tel quel, sur une seule ligne :
# VITE_BASED_SESSION={"user":{...},"accessToken":"...","refreshToken":"..."}
VITE_BASED_SESSION=
